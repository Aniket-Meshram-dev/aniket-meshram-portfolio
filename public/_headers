# Cloudflare Pages HTTP Headers Configuration
# Global Security & SEO Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: index, follow

# Static Build Assets (Vite Fingerprinted Hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons, Webmanifest, & Metadata
/favicon.ico
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400

# Images, Certificates & Static Media
/certificates/*
  Cache-Control: public, max-age=2592000
/stickers/*
  Cache-Control: public, max-age=2592000
/projects/*
  Cache-Control: public, max-age=2592000

# HTML, Robots, & Sitemap (Fast Revalidation)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
